---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import DownloadBanner from '../components/DownloadBanner.astro';
import TesterSignup from '../components/TesterSignup.astro';
import GuideSection from '../components/GuideSection.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Brote — Your corner for caring for what grows at home"
  description="Brote helps you care for your plants with a personal journal, smart reminders, and an AI companion. Available on Android."
>
  <Header />
  <main>
    <Hero />
    <DownloadBanner />
    <TesterSignup />
    <GuideSection />
    <BlogPreview />
  </main>
  <Footer />
</BaseLayout>
